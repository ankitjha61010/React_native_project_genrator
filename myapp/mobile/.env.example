# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored – never commit real secrets.
# The backend API, including its version prefix. `localhost` also works on the Android emulator
# (the app rewrites it to 10.0.2.2); on a real device use your computer's LAN IP.
API_BASE_URL=http://localhost:3000/api/v1
# Socket.IO server – empty: the origin of API_BASE_URL.
SOCKET_URL=
APP_ENV=development
# Terms & Conditions / Privacy Policy links come from the backend (GET /legal) – nothing to set here.

# API payload encryption (AES-256-CBC, PKCS7 – crypto-js). Must match the backend.
# Set API_ENCRYPTION_ENABLED=false to talk to a backend that doesn't encrypt (e.g. locally).
API_ENCRYPTION_ENABLED=true
# Exactly 32 characters (AES-256 key) and 16 characters (IV).
API_ENCRYPTION_KEY=ak5cSy38gd8XZoyF1mZ7cAjz84R39snA
API_ENCRYPTION_IV=mNdA9wwSgtmJJYr2

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials, see docs/SOCIAL_LOGIN.md).
# Web client id: used on both platforms to get an ID token for your backend.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# iOS client id (its reversed form must also be a URL scheme in ios/myapp/Info.plist).
GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com

# Google Location SDK – Places search + reverse geocoding (Google Cloud Console → APIs & Services:
# enable "Places API (New)" and "Geocoding API", then create an API key restricted to this app).
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

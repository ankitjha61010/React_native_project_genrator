{
  "name": "rn-architecture-generator",
  "version": "1.0.0",
  "description": "Interactive CLI that generates production-ready React Native (TypeScript) projects with a selectable architecture, navigation, Firebase messaging, i18n, API/storage services and more.",
  "type": "module",
  "bin": {
    "rn-architecture-generator": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "verify:projects": "node scripts/verify-generated-projects.mjs",
    "generate": "node bin/cli.js",
    "generate_from_another_machine": "node /Users/hyperlink/Desktop/Module/React_project_genrator/rn-architecture-generator/bin/cli.js"
  },
  "keywords": [
    "react-native",
    "generator",
    "cli",
    "architecture",
    "boilerplate",
    "starter",
    "typescript",
    "firebase",
    "clean-architecture",
    "mvvm"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "fs-extra": "^11.3.2",
    "gradient-string": "^3.0.0",
    "ora": "^9.0.0",
    "plist": "^3.1.0",
    "semver": "^7.7.2",
    "xcode": "^3.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/plist": "^3.0.5",
    "@types/semver": "^7.7.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
NEXT_PUBLIC_API_BASE_URL={{API_BASE_URL}}
NEXT_PUBLIC_APP_NAME={{DISPLAY_NAME}}
{{#if API_ENCRYPTION}}
# Must match the backend's API_ENCRYPTION_* (backend/.env)
NEXT_PUBLIC_API_ENCRYPTION_ENABLED=true
NEXT_PUBLIC_API_ENCRYPTION_KEY={{API_ENCRYPTION_KEY}}
NEXT_PUBLIC_API_ENCRYPTION_IV={{API_ENCRYPTION_IV}}
{{else}}
NEXT_PUBLIC_API_ENCRYPTION_ENABLED=false
{{/if}}

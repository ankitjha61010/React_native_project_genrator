VITE_API_BASE_URL={{API_BASE_URL}}
VITE_APP_NAME={{DISPLAY_NAME}}
{{#if API_ENCRYPTION}}
# Must match the backend's API_ENCRYPTION_* (backend/.env)
VITE_API_ENCRYPTION_ENABLED=true
VITE_API_ENCRYPTION_KEY={{API_ENCRYPTION_KEY}}
VITE_API_ENCRYPTION_IV={{API_ENCRYPTION_IV}}
{{else}}
VITE_API_ENCRYPTION_ENABLED=false
{{/if}}

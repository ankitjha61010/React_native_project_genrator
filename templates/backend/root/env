{{#if ENV_EXAMPLE}}
# Copy to .env and fill in the values. Never commit .env – it holds secrets.
{{else}}
# Local development values. Generated with random JWT secrets – never commit this file.
{{/if}}

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT={{PORT}}
HOST=0.0.0.0
{{#if MICROSERVICE}}
# Public URL of the API gateway (links, uploaded file URLs).
{{else}}
# Public URL of this API (links, uploaded file URLs).
{{/if}}
APP_URL=http://localhost:3000
# Routes are served under /<API_PREFIX>/<API_VERSION>, e.g. /api/v1/auth/login
API_PREFIX=api
API_VERSION=v1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting).
TRUST_PROXY={{TRUST_PROXY}}
{{#if SEC_CORS}}

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma separated list of allowed browser origins. Native mobile apps don't send an Origin header
# and are always allowed. Empty = no browser origin allowed.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
{{/if}}
{{#if SEC_BODY_LIMIT}}

# ── Request limits ───────────────────────────────────────────────────────────
BODY_LIMIT=1mb
{{/if}}
{{#if SEC_RATE_LIMIT}}

# ── Rate limiting (per client IP) ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
{{/if}}
{{#if SEC_AUTH_RATE_LIMIT}}
# Stricter limit for login / register / password reset.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
{{/if}}

{{#if REDIS}}
{{#if EVENTS}}
# ── Redis (events between services, rate limits, cache{{#if REDIS_CODES}}, verification codes{{/if}}) ─────────
{{else}}
# ── Redis (rate limits, Socket.IO, cache{{#if REDIS_CODES}}, verification codes{{/if}}) ─────────────────────
{{/if}}
REDIS_URL=redis://localhost:6379

{{/if}}
# ── Database ({{DATABASE_LABEL}} · {{ORM_NAME}}) ─────────────────────────────
{{#if ENV_EXAMPLE}}
{{#if POSTGRES}}
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/{{DB_NAME}}?schema=public
{{/if}}
{{#if MYSQL}}
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/{{DB_NAME}}
{{/if}}
{{#if MONGO}}
DATABASE_URL=mongodb://USER:PASSWORD@localhost:27017/{{DB_NAME}}?authSource=admin
{{/if}}
{{else}}
DATABASE_URL={{DATABASE_URL}}
{{/if}}
{{#if AUTH}}

# ── Authentication ({{AUTH_NAME}}) ───────────────────────────────────────────
# At least 32 random characters each, different from each other. Generate: openssl rand -base64 48
{{#if ENV_EXAMPLE}}
JWT_ACCESS_SECRET=
{{else}}
JWT_ACCESS_SECRET={{JWT_ACCESS_SECRET}}
{{/if}}
{{#if AUTH_JWT_ONLY}}
JWT_ACCESS_EXPIRES_IN=1d
{{else}}
JWT_ACCESS_EXPIRES_IN=15m
{{#if ENV_EXAMPLE}}
JWT_REFRESH_SECRET=
{{else}}
JWT_REFRESH_SECRET={{JWT_REFRESH_SECRET}}
{{/if}}
JWT_REFRESH_EXPIRES_IN=30d
{{/if}}
JWT_ISSUER={{JWT_ISSUER}}
JWT_AUDIENCE={{JWT_ISSUER}}-app
{{#if CODES}}
# 6-digit codes (email verification, password reset{{#if AUTH_OTP}}, SMS login{{/if}}).
VERIFICATION_CODE_TTL=10m
VERIFICATION_CODE_RESEND_AFTER=60s
VERIFICATION_CODE_MAX_ATTEMPTS=5
{{/if}}
{{#if AUTH_EMAIL}}

# ── Email ────────────────────────────────────────────────────────────────────
# smtp://user:password@smtp.example.com:587 – empty: emails (and their codes) are only logged.
SMTP_URL=
MAIL_FROM={{DISPLAY_NAME}} <no-reply@example.com>
{{/if}}
{{#if AUTH_OTP}}

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Empty: SMS codes are only logged (development).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
{{/if}}
{{#if SOCIAL}}

# ── Social sign-in ───────────────────────────────────────────────────────────
{{#if SOCIAL_GOOGLE}}
# Comma separated OAuth client ids (web client id used by the app + iOS/Android client ids).
GOOGLE_CLIENT_IDS={{GOOGLE_CLIENT_IDS_VALUE}}
{{/if}}
{{#if SOCIAL_FACEBOOK}}
FACEBOOK_APP_ID={{FACEBOOK_APP_ID_VALUE}}
FACEBOOK_APP_SECRET={{#if !ENV_EXAMPLE}}{{FACEBOOK_APP_SECRET_VALUE}}{{/if}}
{{/if}}
{{#if SOCIAL_APPLE}}
# The iOS bundle id (audience of Apple identity tokens) + a Services ID for web / Android sign-in.
APPLE_CLIENT_IDS={{APPLE_CLIENT_IDS_VALUE}}
{{/if}}
{{/if}}
{{#if UPLOADS}}

# ── Uploads (avatars{{#if CHAT}}, chat media{{/if}}) ─────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=25
{{/if}}
{{#if NOTIFICATIONS}}

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
# Path to the service account JSON (Firebase console → Project settings → Service accounts),
# or the JSON itself. Empty: pushes are only logged.
FIREBASE_SERVICE_ACCOUNT={{#if !ENV_EXAMPLE}}{{FIREBASE_SERVICE_ACCOUNT_VALUE}}{{/if}}
{{else}}
{{#if HAS_CALLING}}

# ── Push notifications / VoIP (Firebase Cloud Messaging) ────────────────────
# Path to the service account JSON (for background incoming call wakeups).
FIREBASE_SERVICE_ACCOUNT={{#if !ENV_EXAMPLE}}{{FIREBASE_SERVICE_ACCOUNT_VALUE}}{{/if}}
{{/if}}
{{/if}}
{{#if HAS_CALLING}}

# ── Calling (Agora Audio & Video) ───────────────────────────────────────────
# Agora App ID & App Certificate from Agora Console (https://console.agora.io).
# Required to generate Agora RTC tokens for audio/video calling.
AGORA_APP_ID={{#if !ENV_EXAMPLE}}{{AGORA_APP_ID_VALUE}}{{/if}}
AGORA_APP_CERTIFICATE={{#if !ENV_EXAMPLE}}{{AGORA_APP_CERTIFICATE_VALUE}}{{/if}}
# Ringing timeout in seconds before call is marked missed.
CALL_TIMEOUT_SECONDS=60
{{/if}}
{{#if LEGAL}}

# ── Legal pages (the app reads these links from GET /api/v1/legal) ───────────
# Empty: the editable pages in public/ served by this API (APP_URL/terms-and-conditions …).
TERMS_URL=
PRIVACY_POLICY_URL=
{{#if DELETE_ACCOUNT}}
# Web page explaining how to delete an account (Google Play requires one).
DELETE_ACCOUNT_URL=
{{/if}}
{{/if}}
{{#if HASH_CONFIGURABLE}}

# ── Password hashing ─────────────────────────────────────────────────────────
# argon2 | bcrypt. Existing hashes keep working after a switch and are upgraded at the next login.
PASSWORD_HASH_ALGORITHM=argon2
BCRYPT_ROUNDS=12
{{/if}}
{{#if HASH_BCRYPT}}

# ── Password hashing (bcrypt) ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
{{/if}}
{{#if SEC_LOCKOUT}}

# ── Account lockout ──────────────────────────────────────────────────────────
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
{{/if}}

# ── Seed (npm run db:seed) ───────────────────────────────────────────────────
# Creates (or promotes) this administrator.
SEED_ADMIN_EMAIL=admin@example.com
{{#if AUTH_EMAIL}}
{{#if ENV_EXAMPLE}}
SEED_ADMIN_PASSWORD=
{{else}}
SEED_ADMIN_PASSWORD=ChangeMe123!
{{/if}}
{{/if}}
{{#if AUTH_OTP}}
SEED_ADMIN_COUNTRY_CODE=
SEED_ADMIN_PHONE=
{{/if}}
SEED_ADMIN_NAME=Administrator
{{/if}}
{{#if API_ENCRYPTION}}

# ── API encryption (must match the app's API_ENCRYPTION_KEY / API_ENCRYPTION_IV) ──
API_ENCRYPTION_ENABLED=true
{{#if ENV_EXAMPLE}}
API_ENCRYPTION_KEY=
API_ENCRYPTION_IV=
{{else}}
API_ENCRYPTION_KEY={{API_ENCRYPTION_KEY}}
API_ENCRYPTION_IV={{API_ENCRYPTION_IV}}
{{/if}}
{{/if}}
{{#if SWAGGER}}

# ── API documentation ────────────────────────────────────────────────────────
# Served at /<API_PREFIX>/<SWAGGER_PATH> (e.g. /api/docs). Disable in production if the API is private.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
{{/if}}

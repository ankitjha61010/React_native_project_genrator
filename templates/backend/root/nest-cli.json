{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "{{NEST_ENTRY}}",
  "compilerOptions": {
    "deleteOutDir": true,
{{#if SWAGGER}}
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": { "introspectComments": true, "classValidatorShim": true, "dtoFileNameSuffix": [".dto.ts"] }
      }
    ]
{{else}}
    "tsConfigPath": "tsconfig.build.json"
{{/if}}
  }
}

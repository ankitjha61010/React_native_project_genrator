// {{DISPLAY_NAME}} – database schema ({{DATABASE_LABEL}}).
// After changing it: npm run db:migrate -- --name <change>   (creates + applies a migration)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
{{#if POSTGRES}}
  provider = "postgresql"
{{else}}
  provider = "mysql"
{{/if}}
}

model User {
{{#if POSTGRES}}
  id                  String         @id @default(uuid()) @db.Uuid
{{else}}
  id                  String         @id @default(uuid()) @db.Char(36)
{{/if}}
  email               String         @unique @db.VarChar(255)
  name                String         @db.VarChar(120)
{{#if AUTH}}
  passwordHash        String         @map("password_hash") @db.VarChar(255)
  role                String         @default("user") @db.VarChar(20)
  emailVerifiedAt     DateTime?      @map("email_verified_at")
  isActive            Boolean        @default(true) @map("is_active")
  tokenVersion        Int            @default(0) @map("token_version")
  lastLoginAt         DateTime?      @map("last_login_at")
{{#if SEC_LOCKOUT}}
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until")
{{/if}}
{{/if}}
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
{{#if AUTH}}
{{#if AUTH_REFRESH}}
  refreshTokens       RefreshToken[]
{{/if}}
  userTokens          UserToken[]
{{/if}}

  @@map("users")
}
{{#if AUTH_REFRESH}}

model RefreshToken {
{{#if POSTGRES}}
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
{{else}}
  id           String    @id @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
{{/if}}
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
{{#if POSTGRES}}
  familyId     String    @map("family_id") @db.Uuid
{{else}}
  familyId     String    @map("family_id") @db.Char(36)
{{/if}}
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
{{#if POSTGRES}}
  replacedById String?   @map("replaced_by_id") @db.Uuid
{{else}}
  replacedById String?   @map("replaced_by_id") @db.Char(36)
{{/if}}
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
{{/if}}
{{#if AUTH}}

model UserToken {
{{#if POSTGRES}}
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
{{else}}
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
{{/if}}
  type      String    @db.VarChar(32)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}
{{/if}}

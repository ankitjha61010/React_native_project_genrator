# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored – never commit real secrets.
API_BASE_URL=https://api.example.com
APP_ENV=development

# Legal pages, opened in the in-app WebView (Login, Profile{{#if DRAWER}}, Drawer{{/if}}). Replace with your real URLs.
TERMS_URL=https://www.example.com/terms-and-conditions
PRIVACY_POLICY_URL=https://www.example.com/privacy-policy
{{#if API_ENCRYPTION}}

# API payload encryption (AES-256-CBC, PKCS7 – crypto-js). Must match the backend.
# Set API_ENCRYPTION_ENABLED=false to talk to a backend that doesn't encrypt (e.g. locally).
API_ENCRYPTION_ENABLED=true
# Exactly 32 characters (AES-256 key) and 16 characters (IV).
API_ENCRYPTION_KEY=change-me-to-your-32-char-aeskey
API_ENCRYPTION_IV=change-me-16char
{{/if}}
{{#if SOCIAL_GOOGLE}}

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials, see docs/SOCIAL_LOGIN.md).
# Web client id: used on both platforms to get an ID token for your backend.
GOOGLE_WEB_CLIENT_ID={{GOOGLE_WEB_CLIENT_ID_PLACEHOLDER}}
# iOS client id (its reversed form must also be a URL scheme in ios/{{APP_NAME}}/Info.plist).
GOOGLE_IOS_CLIENT_ID={{GOOGLE_IOS_CLIENT_ID_PLACEHOLDER}}
{{/if}}

{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // Repeated from @react-native/typescript-config so the editor still understands JSX and
    // imports if that package can't be resolved yet (before `npm install`, or a stale TS server).
    "jsx": "react-jsx",
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
{{TSCONFIG_PATHS}}
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}

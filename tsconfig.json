{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "."
  },
  // Only lint the generator source & tests.
  // The templates/ directory contains Handlebars-style placeholders ({{IMPORT:...}},
  // {{#if FLAG}}) and a tsconfig.json with un-substituted variables — none of which
  // are valid TypeScript. VS Code must not try to typecheck template files.
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "templates"]
}
